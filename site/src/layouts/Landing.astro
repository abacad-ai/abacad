---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";

import { Code } from "astro:components";

import Brand from "../components/landing/Brand.astro";
import type { LandingCopy } from "../content/landing";
import "../styles/tokens.css";
import "../styles/landing.css";

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;
const isZh = copy.lang === "zh";
const origin = "https://abacad.ai";
const canonical = new URL(isZh ? "/zh/" : "/", origin).href;
const enUrl = new URL("/", origin).href;
const zhUrl = new URL("/zh/", origin).href;
const docsHref = isZh ? "/zh/docs/" : "/docs/";
const homeHref = isZh ? "/zh/" : "/";
const ogImage = new URL(isZh ? "/og-zh.png" : "/og.png", origin).href;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "abacad",
  url: canonical,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Windows, Linux, Android, iOS, Web",
  description: copy.meta.description,
  inLanguage: copy.htmlLang,
  isAccessibleForFree: true,
  publisher: {
    "@type": "Organization",
    name: "abacad",
    url: "https://abacad.ai/",
  },
};
---

<!doctype html>
<html lang={copy.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f7f8" />
    <title>{copy.meta.title}</title>
    <meta name="description" content={copy.meta.description} />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="abacad" />
    <meta property="og:title" content={copy.meta.title} />
    <meta property="og:description" content={copy.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.hero.title.join(" ")} />
    <meta property="og:locale" content={isZh ? "zh_CN" : "en_US"} />
    <meta property="og:locale:alternate" content={isZh ? "en_US" : "zh_CN"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={copy.meta.title} />
    <meta name="twitter:description" content={copy.meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  </head>
  <body>
    <a class="skip" href="#main">{copy.skip}</a>

    <header class="site-header">
      <div class="container header-inner">
        <Brand href={homeHref} />

        <nav class="nav-links" aria-label="Primary">
          <a href="#agents">{copy.nav.agents}</a>
          <a href={docsHref}>{copy.nav.docs}</a>
          <a href="https://github.com/abacad-ai/abacad" target="_blank" rel="noreferrer">
            {copy.nav.github}
          </a>
        </nav>

        <div class="header-actions">
          <a
            class="lang"
            href={copy.nav.switchHref}
            hreflang={copy.nav.switchLang}
            lang={copy.nav.switchLang}
          >
            {copy.nav.switchLabel}
          </a>
          <a class="btn btn-ink btn-sm" href={copy.hero.primaryHref}>
            {copy.nav.cta}
          </a>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <div class="container">
          <p class="kicker">{copy.hero.kicker}</p>
          <h1>{copy.hero.title[0]}<br />{copy.hero.title[1]}</h1>
          <p class="hero-lead" set:html={copy.hero.lead} />

          <div class="hero-actions">
            <a class="btn btn-ink" href={copy.hero.primaryHref}>{copy.hero.primary}</a>
            <a class="btn btn-ghost" href={copy.hero.secondaryHref}>{copy.hero.secondary}</a>
          </div>

          <p class="hero-note">{copy.hero.note}</p>

          <div class="shelf">
            <div class="shelf-head">
              <span class="shelf-live"><i class="dot live"></i>{copy.shelf.live}</span>
              <span class="shelf-meta">{copy.shelf.meta}</span>
            </div>

            <div class="shelf-grid">
              <figure class="shot phone">
                <figcaption>
                  <span class="shot-os"><i class="dot live"></i>{copy.shelf.android.os}</span>
                  <span class="shot-name">{copy.shelf.android.name}</span>
                </figcaption>
                <img
                  src={copy.shelf.android.src}
                  width={copy.shelf.android.width}
                  height={copy.shelf.android.height}
                  alt={copy.shelf.android.alt}
                  fetchpriority="high"
                />
              </figure>

              <div class="shot-stack">
                <figure class="shot">
                  <figcaption>
                    <span class="shot-os"><i class="dot live"></i>{copy.shelf.windows.os}</span>
                    <span class="shot-name">{copy.shelf.windows.name}</span>
                  </figcaption>
                  <img
                    src={copy.shelf.windows.src}
                    width={copy.shelf.windows.width}
                    height={copy.shelf.windows.height}
                    alt={copy.shelf.windows.alt}
                    fetchpriority="high"
                  />
                </figure>

                <figure class="shot">
                  <figcaption>
                    <span class="shot-os"><i class="dot live"></i>{copy.shelf.debian.os}</span>
                    <span class="shot-name">{copy.shelf.debian.name}</span>
                  </figcaption>
                  <img
                    src={copy.shelf.debian.src}
                    width={copy.shelf.debian.width}
                    height={copy.shelf.debian.height}
                    alt={copy.shelf.debian.alt}
                  />
                </figure>
              </div>
            </div>

            <div class="shelf-foot">
              <span>{copy.shelf.caption}</span>
              <span>{copy.shelf.foot}</span>
            </div>
          </div>
        </div>
      </section>

      <section class="claims" aria-label="Why abacad">
        <div class="container claim-grid">
          {copy.claims.map((claim, index) => (
            <article class="claim">
              <span class="claim-index">{String(index + 1).padStart(2, "0")}</span>
              <h2>{claim.title}</h2>
              <p>{claim.body}</p>
            </article>
          ))}
        </div>
      </section>

      <section class="works" aria-label={copy.works.label}>
        <div class="container works-inner">
          <span class="works-label">{copy.works.label}</span>
          <ul class="works-list">
            {copy.works.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </section>

      <section class="agents" id="agents">
        <div class="container agent-grid">
          <div class="agent-copy">
            <p class="kicker">{copy.agents.kicker}</p>
            <h2>{copy.agents.title}</h2>
            <p class="agent-lead" set:html={copy.agents.lead} />
            <p class="agent-note">{copy.agents.note}</p>
            <a class="text-link" href={copy.agents.ctaHref}>{copy.agents.cta}</a>
          </div>

          <div class="code-card">
            <div class="code-head">
              <span>{copy.agents.codeTitle}</span>
              <button
                class="copy"
                type="button"
                data-copy={copy.agents.code}
                data-copied={copy.agents.copied}
                aria-label={copy.agents.copy}
              >
                <span>{copy.agents.copy}</span>
              </button>
            </div>
            <Code code={copy.agents.code} lang="json" theme="github-dark" />
          </div>
        </div>
      </section>

      <section class="final">
        <div class="container final-inner">
          <h2>{copy.final.title}</h2>
          <p class="final-lead">{copy.final.lead}</p>

          <div class="command">
            <div class="command-head">
              <span>{copy.final.commandLabel}</span>
              <button
                class="copy"
                type="button"
                data-copy={copy.final.command}
                data-copied={copy.final.copied}
                aria-label={copy.final.copy}
              >
                <span>{copy.final.copy}</span>
              </button>
            </div>
            <pre><code>{copy.final.command}</code></pre>
          </div>

          <a class="text-link final-link" href={copy.final.docsHref}>{copy.final.docs} →</a>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <Brand href={homeHref} />
        <p class="footer-tagline">{copy.footer.tagline}</p>
        <nav class="footer-links" aria-label="Footer">
          {copy.footer.links.map((link) => (
            <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noreferrer" : undefined}>
              {link.label}
            </a>
          ))}
        </nav>
      </div>
      <div class="container footer-bottom">
        <span>{copy.footer.bottom}</span>
        <span>{copy.footer.privacy}</span>
      </div>
    </footer>

    <script>
      async function writeClipboard(text: string) {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          const textarea = document.createElement("textarea");
          textarea.value = text;
          textarea.setAttribute("readonly", "");
          textarea.style.position = "fixed";
          textarea.style.opacity = "0";
          document.body.appendChild(textarea);
          textarea.select();
          const ok = document.execCommand("copy");
          textarea.remove();
          return ok;
        }
      }

      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
        button.addEventListener("click", async () => {
          const text = button.dataset.copy ?? "";
          const label = button.querySelector("span");
          const original = label?.textContent ?? button.textContent ?? "";
          if (!text) return;
          const ok = await writeClipboard(text);
          if (!ok) return;
          if (label) label.textContent = button.dataset.copied ?? "Copied";
          button.classList.add("copied");
          window.setTimeout(() => {
            if (label) label.textContent = original;
            button.classList.remove("copied");
          }, 1600);
        });
      });
    </script>
  </body>
</html>
