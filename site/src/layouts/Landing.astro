---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";

import Brand from "../components/landing/Brand.astro";
import Console from "../components/landing/Console.astro";
import FlowDiagram from "../components/landing/FlowDiagram.astro";
import Icon from "../components/landing/Icon.astro";
import SectionHead from "../components/landing/SectionHead.astro";
import type { LandingCopy } from "../content/landing";
import "../styles/tokens.css";
import "../styles/landing.css";

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;
const isZh = copy.lang === "zh";
const origin = "https://abacad.ai";
const canonical = new URL(isZh ? "/zh/" : "/", origin).href;
const enUrl = new URL("/", origin).href;
const zhUrl = new URL("/zh/", origin).href;
const docsHref = isZh ? "/zh/docs/" : "/docs/";
const homeHref = isZh ? "/zh/" : "/";
const ogImage = new URL(isZh ? "/og-zh.png" : "/og.png", origin).href;

const noteHtml = copy.hero.commandNote.replace(/`([^`]+)`/g, "<code>$1</code>");
const finalNoteHtml = copy.final.commandLabel;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "abacad",
  url: canonical,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Windows, Linux, Android, iOS, Web",
  description: copy.meta.description,
  inLanguage: copy.htmlLang,
  isAccessibleForFree: true,
  publisher: {
    "@type": "Organization",
    name: "abacad",
    url: "https://abacad.ai/",
  },
};

const faqSchema = {
  "@context": "https://schema.org",
  "@type": "FAQPage",
  inLanguage: copy.htmlLang,
  mainEntity: copy.faq.items.map((item) => ({
    "@type": "Question",
    name: item.q,
    acceptedAnswer: { "@type": "Answer", text: item.a },
  })),
};
---

<!doctype html>
<html lang={copy.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f7f8" />
    <title>{copy.meta.title}</title>
    <meta name="description" content={copy.meta.description} />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="abacad" />
    <meta property="og:title" content={copy.meta.title} />
    <meta property="og:description" content={copy.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content="abacad — a self-hosted VNC hub" />
    <meta property="og:locale" content={isZh ? "zh_CN" : "en_US"} />
    <meta property="og:locale:alternate" content={isZh ? "en_US" : "zh_CN"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={copy.meta.title} />
    <meta name="twitter:description" content={copy.meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
    <script type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
  </head>
  <body>
    <a class="skip" href="#main">{copy.skip}</a>

    <header class="site-header">
      <div class="container header-inner">
        <Brand href={homeHref} />

        <nav class="nav-links" aria-label="Primary">
          <a href="#how">{copy.nav.how}</a>
          <a href="#devices">{copy.nav.devices}</a>
          <a href="#agents">{copy.nav.agents}</a>
          <a href={docsHref}>{copy.nav.docs}</a>
          <a href="https://github.com/abacad-ai/abacad" target="_blank" rel="noreferrer">
            {copy.nav.github}
            <Icon name="external" class="size-3" />
          </a>
        </nav>

        <div class="header-actions">
          <a class="header-docs" href={docsHref}>{copy.nav.docs}</a>
          <a
            class="lang"
            href={copy.nav.switchHref}
            hreflang={copy.nav.switchLang}
            lang={copy.nav.switchLang}
          >
            {copy.nav.switchLabel}
          </a>
          <a class="btn btn-ink btn-sm" href={copy.hero.primaryHref}>
            {copy.nav.cta}
            <Icon name="arrow" class="size-3.5" />
          </a>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <div class="container hero-grid">
          <div class="hero-copy">
            <p class="eyebrow">{copy.hero.eyebrow}</p>
            <h1>{copy.hero.title}</h1>
            <p class="hero-lead">{copy.hero.lead}</p>

            <div class="hero-actions">
              <a class="btn btn-ink" href={copy.hero.primaryHref}>
                {copy.hero.primary}
                <Icon name="arrow" class="size-4" />
              </a>
              <a class="btn btn-ghost" href={copy.hero.secondaryHref}>{copy.hero.secondary}</a>
            </div>

            <p class="hero-note">
              <span class="dot live"></span>
              {copy.hero.note}
            </p>

            <div class="command">
              <div class="command-head">
                <span class="mono-label">{copy.hero.commandLabel}</span>
                <button
                  class="copy"
                  type="button"
                  data-copy={copy.hero.command}
                  data-copied={copy.hero.copied}
                  aria-label={copy.hero.copy}
                >
                  <Icon name="copy" class="size-3" />
                  <span>{copy.hero.copy}</span>
                </button>
              </div>
              <pre><code>{copy.hero.command}</code></pre>
              <p class="command-note" set:html={noteHtml} />
            </div>
          </div>

          <div class="hero-visual">
            <Console copy={copy.console} />
          </div>
        </div>
      </section>

      <section class="works" aria-label={copy.worksWith.label}>
        <div class="container works-inner">
          <p class="mono-label works-label">{copy.worksWith.label}</p>
          <ul class="works-list">
            {copy.worksWith.items.map((item) => <li>{item}</li>)}
          </ul>
        </div>
      </section>

      <section class="section" id="why">
        <div class="container">
          <SectionHead eyebrow={copy.why.eyebrow} title={copy.why.title} lead={copy.why.lead} />
          <div class="card-grid">
            {copy.why.cards.map((card) => (
              <article class="card">
                <span class="card-icon"><Icon name={card.icon} class="size-4" /></span>
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </article>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="how">
        <div class="container split">
          <div>
            <SectionHead eyebrow={copy.how.eyebrow} title={copy.how.title} lead={copy.how.lead} />
            <div class="steps">
              {copy.how.steps.map((step) => (
                <div class="step">
                  <span class="step-label">{step.label}</span>
                  <div>
                    <h3>{step.title}</h3>
                    <p>{step.body}</p>
                  </div>
                </div>
              ))}
            </div>
            <p class="note">
              {copy.how.note}
              <a href={copy.how.noteHref}>{copy.how.noteLink}</a>
            </p>
            <a class="text-link" href={copy.how.ctaHref}>
              {copy.how.cta}
              <Icon name="arrow" class="size-3.5" />
            </a>
          </div>
          <FlowDiagram lang={copy.lang} />
        </div>
      </section>

      <section class="section" id="devices">
        <div class="container">
          <SectionHead
            eyebrow={copy.platforms.eyebrow}
            title={copy.platforms.title}
            lead={copy.platforms.lead}
          />
          <div class="platform-grid">
            {copy.platforms.items.map((item, index) => (
              <a class="platform" href={item.href}>
                <span class="platform-index">{String(index + 1).padStart(2, "0")}</span>
                <span class="platform-name">{item.name}</span>
                <span class="platform-kicker">{item.kicker}</span>
                <span class="platform-body">{item.body}</span>
                <span class="platform-link">
                  {copy.platforms.link}
                  <Icon name="arrow" class="size-3" />
                </span>
              </a>
            ))}
          </div>
        </div>
      </section>

      <section class="section" id="agents">
        <div class="container agent-split">
          <div>
            <SectionHead
              eyebrow={copy.agents.eyebrow}
              title={copy.agents.title}
              lead={copy.agents.lead}
            />
            <ul class="check-list">
              {copy.agents.bullets.map((bullet) => (
                <li>
                  <Icon name="check" class="size-4" />
                  <span>{bullet}</span>
                </li>
              ))}
            </ul>
            <div class="hero-actions">
              <a class="btn btn-ink" href={copy.agents.ctaHref}>
                {copy.agents.cta}
                <Icon name="arrow" class="size-4" />
              </a>
              <a class="btn btn-ghost" href={copy.agents.secondaryHref}>{copy.agents.secondary}</a>
            </div>
            <p class="fine">{copy.agents.note}</p>
          </div>

          <div class="code-card">
            <div class="code-head">
              <span class="code-dot"></span>
              <span>{copy.agents.codeTitle}</span>
              <span class="code-lang">json</span>
            </div>
            <pre class="code-pre"><code>{copy.agents.code}</code></pre>
          </div>
        </div>
      </section>

      <section class="section" id="human">
        <div class="container">
          <SectionHead
            eyebrow={copy.human.eyebrow}
            title={copy.human.title}
            lead={copy.human.lead}
          />
          <div class="handoff">
            <div class="handoff-side agent">
              <span class="handoff-label">{copy.human.agentLabel}</span>
              <p>{copy.human.agentText}</p>
            </div>
            <div class="handoff-arrow"><Icon name="arrow" class="size-5" /></div>
            <div class="handoff-side you">
              <span class="handoff-label">{copy.human.humanLabel}</span>
              <p>{copy.human.humanText}</p>
            </div>
          </div>
          <p class="handoff-result">
            <span class="dot live"></span>
            {copy.human.result}
          </p>
          <a class="text-link" href={copy.human.ctaHref}>
            {copy.human.cta}
            <Icon name="arrow" class="size-3.5" />
          </a>
        </div>
      </section>

      <section class="section" id="security">
        <div class="container">
          <SectionHead
            eyebrow={copy.selfHosted.eyebrow}
            title={copy.selfHosted.title}
            lead={copy.selfHosted.lead}
          />
          <div class="card-grid">
            {copy.selfHosted.cards.map((card) => (
              <article class="card">
                <span class="card-icon"><Icon name={card.icon} class="size-4" /></span>
                <h3>{card.title}</h3>
                <p>{card.body}</p>
              </article>
            ))}
          </div>
          <a class="text-link" href={copy.selfHosted.ctaHref}>
            {copy.selfHosted.cta}
            <Icon name="arrow" class="size-3.5" />
          </a>
        </div>
      </section>

      <section class="section" id="faq">
        <div class="container">
          <SectionHead eyebrow={copy.faq.eyebrow} title={copy.faq.title} />
          <div class="faq-list">
            {copy.faq.items.map((item) => (
              <details>
                <summary>
                  {item.q}
                  <span class="faq-plus" aria-hidden="true"></span>
                </summary>
                <p>{item.a}</p>
              </details>
            ))}
          </div>
        </div>
      </section>

      <section class="final">
        <div class="container final-inner">
          <h2>{copy.final.title}</h2>
          <p class="final-lead">{copy.final.lead}</p>
          <div class="final-actions">
            <a class="btn btn-ink" href={copy.final.primaryHref}>
              {copy.final.primary}
              <Icon name="arrow" class="size-4" />
            </a>
            <a class="btn btn-ghost" href={copy.final.secondaryHref}>{copy.final.secondary}</a>
          </div>

          <div class="command command-final">
            <div class="command-head">
              <span class="mono-label">{finalNoteHtml}</span>
              <button
                class="copy"
                type="button"
                data-copy={copy.final.command}
                data-copied={copy.final.copied}
                aria-label={copy.final.copy}
              >
                <Icon name="copy" class="size-3" />
                <span>{copy.final.copy}</span>
              </button>
            </div>
            <pre><code>{copy.final.command}</code></pre>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container footer-grid">
        <div class="footer-brand">
          <Brand href={homeHref} />
          <p>{copy.footer.tagline}</p>
        </div>
        {copy.footer.columns.map((column) => (
          <div class="footer-col">
            <p class="mono-label">{column.title}</p>
            <ul>
              {column.links.map((link) => (
                <li>
                  <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noreferrer" : undefined}>
                    {link.label}
                  </a>
                </li>
              ))}
            </ul>
          </div>
        ))}
      </div>
      <div class="container footer-bottom">
        <span>{copy.footer.bottom}</span>
        <span>{copy.footer.privacy}</span>
      </div>
    </footer>

    <script>
      async function writeClipboard(text: string) {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          const textarea = document.createElement("textarea");
          textarea.value = text;
          textarea.setAttribute("readonly", "");
          textarea.style.position = "fixed";
          textarea.style.opacity = "0";
          document.body.appendChild(textarea);
          textarea.select();
          const ok = document.execCommand("copy");
          textarea.remove();
          return ok;
        }
      }

      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
        button.addEventListener("click", async () => {
          const text = button.dataset.copy ?? "";
          const label = button.querySelector("span");
          const original = label?.textContent ?? button.textContent ?? "";
          if (!text) return;
          const ok = await writeClipboard(text);
          if (!ok) return;
          if (label) label.textContent = button.dataset.copied ?? "Copied";
          button.classList.add("copied");
          window.setTimeout(() => {
            if (label) label.textContent = original;
            button.classList.remove("copied");
          }, 1600);
        });
      });
    </script>
  </body>
</html>
