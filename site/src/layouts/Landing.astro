---
import "@fontsource-variable/geist";
import "@fontsource-variable/geist-mono";


import AgentLogos from "../components/landing/AgentLogos.astro";
import Brand from "../components/landing/Brand.astro";
import type { LandingCopy } from "../content/landing";
import "../styles/tokens.css";
import "../styles/landing.css";

interface Props {
  copy: LandingCopy;
}

const { copy } = Astro.props;
const devices = copy.shelf.devices;
const isZh = copy.lang === "zh";
const origin = "https://abacad.ai";
const canonical = new URL(isZh ? "/zh/" : "/", origin).href;
const enUrl = new URL("/", origin).href;
const zhUrl = new URL("/zh/", origin).href;
const docsHref = isZh ? "/zh/docs/" : "/docs/";
const homeHref = isZh ? "/zh/" : "/";
const ogImage = new URL(isZh ? "/og-zh.png" : "/og.png", origin).href;

const softwareSchema = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "abacad",
  url: canonical,
  applicationCategory: "DeveloperApplication",
  operatingSystem: "macOS, Windows, Linux, Android, iOS, Web",
  description: copy.meta.description,
  inLanguage: copy.htmlLang,
  isAccessibleForFree: true,
  publisher: {
    "@type": "Organization",
    name: "abacad",
    url: "https://abacad.ai/",
  },
};
---

<!doctype html>
<html lang={copy.htmlLang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#f6f7f8" />
    <title>{copy.meta.title}</title>
    <meta name="description" content={copy.meta.description} />
    <link rel="canonical" href={canonical} />

    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="zh-CN" href={zhUrl} />
    <link rel="alternate" hreflang="x-default" href={enUrl} />

    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="icon" href="/favicon-32.png" sizes="32x32" type="image/png" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="abacad" />
    <meta property="og:title" content={copy.meta.title} />
    <meta property="og:description" content={copy.meta.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={copy.hero.title.join(" ")} />
    <meta property="og:locale" content={isZh ? "zh_CN" : "en_US"} />
    <meta property="og:locale:alternate" content={isZh ? "en_US" : "zh_CN"} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={copy.meta.title} />
    <meta name="twitter:description" content={copy.meta.description} />
    <meta name="twitter:image" content={ogImage} />

    <link rel="sitemap" type="application/xml" title="Sitemap" href="/sitemap-index.xml" />

    <script type="application/ld+json" set:html={JSON.stringify(softwareSchema)} />
  </head>
  <body>
    <a class="skip" href="#main">{copy.skip}</a>

    <header class="site-header">
      <div class="container header-inner">
        <Brand href={homeHref} />

        <nav class="nav-links" aria-label="Primary">
          <a href="#agents">{copy.nav.agents}</a>
          <a href={docsHref}>{copy.nav.docs}</a>
          <a href="https://github.com/abacad-ai/abacad" target="_blank" rel="noreferrer">
            {copy.nav.github}
          </a>
        </nav>

        <div class="header-actions">
          <a
            class="lang"
            href={copy.nav.switchHref}
            hreflang={copy.nav.switchLang}
            lang={copy.nav.switchLang}
          >
            {copy.nav.switchLabel}
          </a>
          <a class="btn btn-ink btn-sm" href={copy.hero.primaryHref}>
            {copy.nav.cta}
          </a>
        </div>
      </div>
    </header>

    <main id="main">
      <section class="hero">
        <div class="container hero-grid">
          <p class="hero-eyebrow">{copy.hero.eyebrow}</p>
          <h1>
            <span class="h1-line">{copy.hero.title[0]}</span>{" "}
            <span class="h1-line">{copy.hero.title[1]}</span>
          </h1>
          <div class="hero-side">
            <p class="hero-lead">{copy.hero.lead}</p>
            <div class="hero-actions">
              <a class="btn btn-ink" href={copy.hero.primaryHref}>{copy.hero.primary}</a>
              <a class="btn btn-ghost" href={copy.hero.secondaryHref}>{copy.hero.secondary}</a>
            </div>
          </div>
        </div>
      </section>

      <section class="platforms" aria-labelledby="platforms-title">
        <div class="container">
          <div class="section-head">
            <div>
              <h2 id="platforms-title">{copy.platforms.title}</h2>
            </div>
            <p class="section-note">{copy.platforms.note}</p>
          </div>

          <div class="showcase" data-carousel>
            <div class="showcase-nav">
              <div class="showcase-tabs" role="tablist" aria-label={copy.shelf.railLabel}>
                {devices.map((device, index) => (
                  <button
                    class:list={["showcase-tab", { active: index === 0 }]}
                    type="button"
                    role="tab"
                    id={`tab-${device.id}`}
                    aria-controls={`screen-${device.id}`}
                    aria-selected={index === 0 ? "true" : "false"}
                    tabindex={index === 0 ? 0 : -1}
                    data-tab
                    data-index={String(index)}
                  >
                    <span>{device.os}</span>
                  </button>
                ))}
              </div>

              <div class="showcase-controls">
                <button
                  class="showcase-toggle"
                  type="button"
                  data-toggle
                  data-pause={copy.shelf.pause}
                  data-play={copy.shelf.play}
                  aria-label={copy.shelf.pause}
                >
                  <span data-toggle-label>{copy.shelf.pause}</span>
                </button>
              </div>
            </div>

            <div
              class="showcase-stage"
              data-stage
              role="group"
              aria-roledescription="carousel"
              aria-label={copy.shelf.stageLabel}
              tabindex="0"
            >
              <div class="showcase-viewport" data-stage-viewport>
                {devices.map((device, index) => (
                  <figure
                    class:list={["slide", device.kind, { active: index === 0 }]}
                    id={`screen-${device.id}`}
                    role="tabpanel"
                    aria-labelledby={`tab-${device.id}`}
                    data-slide
                    aria-hidden={index === 0 ? "false" : "true"}
                  >
                    <img
                      src={device.src}
                      width={device.width}
                      height={device.height}
                      alt={device.alt}
                      loading={index === 0 ? "eager" : "lazy"}
                      fetchpriority={index === 0 ? "high" : "auto"}
                      decoding="async"
                    />
                    <figcaption class="slide-caption" aria-hidden="true">
                      <span class="live-dot"></span>{device.name}
                    </figcaption>
                  </figure>
                ))}

                <button class="stage-arrow prev" type="button" aria-label={copy.shelf.prev} data-prev>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M15 18l-6-6 6-6"></path>
                  </svg>
                </button>
                <button class="stage-arrow next" type="button" aria-label={copy.shelf.next} data-next>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
                    <path d="M9 6l6 6-6 6"></path>
                  </svg>
                </button>
              </div>
            </div>

          </div>
        </div>
      </section>

      <section class="agents" id="agents" aria-labelledby="agents-title">
        <div class="container agents-grid">
          <div class="agents-copy">
            <h2 id="agents-title">{copy.agents.title}</h2>
            <p class="section-note">{copy.agents.lead}</p>
            <a class="text-link" href={copy.agents.ctaHref}>{copy.agents.cta} →</a>
          </div>
          <div class="agents-wall">
            <AgentLogos more={copy.agents.more} />
            <p class="legal">{copy.agents.legal}</p>
          </div>
        </div>
      </section>

      <section class="final" aria-labelledby="final-title">
        <div class="container final-grid">
          <div class="final-copy">
            <h2 id="final-title">{copy.final.title}</h2>
            <p class="section-note">{copy.final.lead}</p>
            <a class="text-link" href={copy.final.docsHref}>{copy.final.docs} →</a>
          </div>

          <div class="command">
            <div class="command-head">
              <span class="command-label">{copy.final.commandLabel}</span>
              <button
                class="copy"
                type="button"
                data-copy={copy.final.command}
                data-copied={copy.final.copied}
                aria-label={copy.final.copy}
              >
                <span>{copy.final.copy}</span>
              </button>
            </div>
            <pre><span class="prompt" aria-hidden="true">$</span><code>{copy.final.command}</code></pre>
          </div>
        </div>
      </section>
    </main>

    <footer class="footer">
      <div class="container footer-inner">
        <Brand href={homeHref} />
        <p class="footer-tagline">{copy.footer.tagline}</p>
        <nav class="footer-links" aria-label="Footer">
          {copy.footer.links.map((link) => (
            <a href={link.href} target={link.href.startsWith("http") ? "_blank" : undefined} rel={link.href.startsWith("http") ? "noreferrer" : undefined}>
              {link.label}
            </a>
          ))}
        </nav>
      </div>
      <div class="container footer-bottom">
        <span>{copy.footer.bottom}</span>
        <span>{copy.footer.privacy}</span>
      </div>
    </footer>

    <script>
      async function writeClipboard(text: string) {
        try {
          await navigator.clipboard.writeText(text);
          return true;
        } catch {
          const textarea = document.createElement("textarea");
          textarea.value = text;
          textarea.setAttribute("readonly", "");
          textarea.style.position = "fixed";
          textarea.style.opacity = "0";
          document.body.appendChild(textarea);
          textarea.select();
          const ok = document.execCommand("copy");
          textarea.remove();
          return ok;
        }
      }

      document.querySelectorAll<HTMLButtonElement>("[data-copy]").forEach((button) => {
        button.addEventListener("click", async () => {
          const text = button.dataset.copy ?? "";
          const label = button.querySelector("span");
          const original = label?.textContent ?? button.textContent ?? "";
          if (!text) return;
          const ok = await writeClipboard(text);
          if (!ok) return;
          if (label) label.textContent = button.dataset.copied ?? "Copied";
          button.classList.add("copied");
          window.setTimeout(() => {
            if (label) label.textContent = original;
            button.classList.remove("copied");
          }, 1600);
        });
      });

      const shelf = document.querySelector<HTMLElement>("[data-carousel]");

      if (shelf) {
        const slides = Array.from(shelf.querySelectorAll<HTMLElement>("[data-slide]"));
        const tabs = Array.from(shelf.querySelectorAll<HTMLButtonElement>("[data-tab]"));
        const stage = shelf.querySelector<HTMLElement>("[data-stage]");
        const viewport = shelf.querySelector<HTMLElement>("[data-stage-viewport]");
        const prev = shelf.querySelector<HTMLButtonElement>("[data-prev]");
        const next = shelf.querySelector<HTMLButtonElement>("[data-next]");
        const toggle = shelf.querySelector<HTMLButtonElement>("[data-toggle]");
        const toggleLabel = shelf.querySelector<HTMLElement>("[data-toggle-label]");

        if (slides.length > 0) {
          const reducedMotion = window.matchMedia("(prefers-reduced-motion: reduce)").matches;
          const narrow = window.matchMedia("(max-width: 760px)").matches;
          const autoPaused = reducedMotion || narrow;
          const period = 6500;
          let index = 0;
          let timer: number | undefined;
          let userPaused = false;
          let hovering = false;
          let focusWithin = false;

          const isPaused = () =>
            userPaused || hovering || focusWithin || document.hidden || autoPaused;

          const clearTimer = () => {
            if (timer !== undefined) {
              window.clearTimeout(timer);
              timer = undefined;
            }
            delete shelf.dataset.running;
          };

          const schedule = () => {
            clearTimer();
            if (isPaused()) return;
            timer = window.setTimeout(() => setActive(index + 1), period);
            delete shelf.dataset.running;
            void shelf.offsetWidth;
            shelf.dataset.running = "true";
          };

          const syncTimer = () => {
            if (isPaused()) {
              clearTimer();
              return;
            }
            schedule();
          };

          const setUserPaused = (value: boolean) => {
            userPaused = value;
            const label = value ? toggle?.dataset.play ?? "" : toggle?.dataset.pause ?? "";
            if (toggleLabel) toggleLabel.textContent = label;
            toggle?.setAttribute("aria-label", label);
          };

          function setActive(nextIndex: number, moveFocus = false) {
            index = (nextIndex + slides.length) % slides.length;

            slides.forEach((element, i) => {
              const active = i === index;
              element.classList.toggle("active", active);
              element.setAttribute("aria-hidden", active ? "false" : "true");
            });

            tabs.forEach((tab, i) => {
              const active = i === index;
              tab.classList.toggle("active", active);
              tab.setAttribute("aria-selected", active ? "true" : "false");
              tab.tabIndex = active ? 0 : -1;
            });

            const rail = tabs[index]?.parentElement;
            const activeTab = tabs[index];
            if (rail && activeTab && rail.scrollWidth > rail.clientWidth) {
              const tabBox = activeTab.getBoundingClientRect();
              const railBox = rail.getBoundingClientRect();
              if (tabBox.left < railBox.left || tabBox.right > railBox.right) {
                rail.scrollBy({
                  left: tabBox.left - railBox.left - 8,
                  behavior: reducedMotion ? "auto" : "smooth",
                });
              }
            }

            if (moveFocus) tabs[index]?.focus();

            schedule();
          }

          toggle?.addEventListener("click", () => {
            focusWithin = false;
            setUserPaused(!userPaused);
            syncTimer();
          });

          prev?.addEventListener("click", (event) => {
            event.stopPropagation();
            focusWithin = false;
            setUserPaused(true);
            setActive(index - 1);
          });

          next?.addEventListener("click", (event) => {
            event.stopPropagation();
            focusWithin = false;
            setUserPaused(true);
            setActive(index + 1);
          });

          viewport?.addEventListener("click", (event) => {
            if ((event.target as HTMLElement).closest("button")) return;
            focusWithin = false;
            setUserPaused(true);
            setActive(index + 1);
          });

          tabs.forEach((tab, i) => {
            tab.addEventListener("click", () => {
              focusWithin = false;
              setUserPaused(true);
              setActive(i);
            });

            tab.addEventListener("keydown", (event) => {
              let target: number | undefined;
              if (event.key === "ArrowRight") target = i + 1;
              else if (event.key === "ArrowLeft") target = i - 1;
              else if (event.key === "Home") target = 0;
              else if (event.key === "End") target = tabs.length - 1;
              if (target === undefined) return;
              event.preventDefault();
              setUserPaused(true);
              setActive(target, true);
            });
          });

          stage?.addEventListener("keydown", (event) => {
            if (event.key === "ArrowRight") {
              event.preventDefault();
              setUserPaused(true);
              setActive(index + 1);
            } else if (event.key === "ArrowLeft") {
              event.preventDefault();
              setUserPaused(true);
              setActive(index - 1);
            }
          });

          shelf.addEventListener("pointerenter", () => {
            hovering = true;
            syncTimer();
          });

          shelf.addEventListener("pointerleave", () => {
            hovering = false;
            syncTimer();
          });

          shelf.addEventListener("focusin", () => {
            focusWithin = true;
            syncTimer();
          });

          shelf.addEventListener("focusout", (event) => {
            if (shelf.contains(event.relatedTarget as Node | null)) return;
            focusWithin = false;
            syncTimer();
          });

          document.addEventListener("visibilitychange", syncTimer);

          if (autoPaused) {
            toggle?.setAttribute("hidden", "");
          }

          setActive(0);
        }
      }
    </script>
  </body>
</html>
