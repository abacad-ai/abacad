---
import type { LandingCopy } from "../../content/landing";

interface Props {
  copy: LandingCopy["console"];
}

const { copy } = Astro.props;
---

<figure class="console" aria-hidden="true">
  <div class="console-bar">
    <div class="console-id">
      <span class="dot live"></span>
      <span class="console-name">{copy.hub}</span>
      <span class="console-slash">/</span>
      <span class="console-mode">hub</span>
    </div>
    <div class="console-address">{copy.address}</div>
  </div>

  <div class="console-body">
    <div class="rail">
      <p class="rail-label">{copy.railLabel}</p>
      {copy.devices.map((device, index) => (
        <div class:list={["device", { active: index === 0 }]}>
          <span class:list={["dot", device.state === "online" ? "live" : "idle"]}></span>
          <span class="device-text">
            <span class="device-name">{device.name}</span>
            <span class="device-meta">{device.meta}</span>
          </span>
        </div>
      ))}
      <div class="rail-add">+ {copy.add}</div>
    </div>

    <div class="viewer">
      <div class="screen">
        <div class="screen-bar">
          <span class="screen-dots"><i></i><i></i><i></i></span>
          <span class="screen-title">{copy.screenLabel}</span>
          <span class="screen-live"><span class="dot live"></span>live</span>
        </div>
        <div class="screen-body">
          {copy.screenLines.map((line, index) => (
            <p class:list={["screen-line", { prompt: index === 0 }]}>
              {line}
              {index === copy.screenLines.length - 1 && <span class="caret"></span>}
            </p>
          ))}
        </div>
        <div class="screen-foot">
          <span>Ctrl Alt Del</span>
          <span>Clipboard</span>
          <span>Fullscreen</span>
        </div>
      </div>
    </div>
  </div>

  <div class="console-foot">
    <span>{copy.footLeft}</span>
    <span>{copy.footRight}</span>
  </div>
</figure>
