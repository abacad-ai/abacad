---
interface Props {
  lang: string;
}

const { lang } = Astro.props;
const labels =
  lang === "zh"
    ? { devices: "VNC 服务", browser: "浏览器", agent: "Agent", hub: "一处入口" }
    : { devices: "VNC servers", browser: "Browser", agent: "Agent", hub: "one hub" };
---

<figure class="flow" aria-hidden="true">
  <svg viewBox="0 0 760 420" role="presentation">
    <defs>
      <marker id="flow-arrow" viewBox="0 0 10 10" refX="9" refY="5" markerWidth="7" markerHeight="7" orient="auto-start-reverse">
        <path d="M0 0 10 5 0 10z" fill="#d7dade" />
      </marker>
    </defs>

    <text x="24" y="28" class="svg-eyebrow">{labels.devices}</text>
    <g class="svg-device">
      <rect x="24" y="44" width="180" height="54" rx="10" />
      <text x="42" y="77" class="svg-device-name">macOS</text>
      <text x="186" y="77" class="svg-device-meta" text-anchor="end">5900</text>
    </g>
    <g class="svg-device">
      <rect x="24" y="112" width="180" height="54" rx="10" />
      <text x="42" y="145" class="svg-device-name">Linux</text>
      <text x="186" y="145" class="svg-device-meta" text-anchor="end">5900</text>
    </g>
    <g class="svg-device">
      <rect x="24" y="180" width="180" height="54" rx="10" />
      <text x="42" y="213" class="svg-device-name">Android</text>
      <text x="186" y="213" class="svg-device-meta" text-anchor="end">5900</text>
    </g>
    <g class="svg-device">
      <rect x="24" y="248" width="180" height="54" rx="10" />
      <text x="42" y="281" class="svg-device-name">iOS</text>
      <text x="186" y="281" class="svg-device-meta" text-anchor="end">iosvnc</text>
    </g>

    <path d="M204 173H258" class="svg-line" marker-end="url(#flow-arrow)" />
    <path d="M204 281H232V173" class="svg-line" fill="none" marker-end="url(#flow-arrow)" />

    <g class="svg-hub">
      <rect x="280" y="118" width="200" height="184" rx="16" />
      <circle cx="308" cy="148" r="4" class="svg-live" />
      <text x="322" y="152" class="svg-hub-name">abacad</text>
      <text x="304" y="192" class="svg-hub-title">{labels.hub}</text>
      <text x="304" y="220" class="svg-mono">/ws/vnc/&lt;id&gt;</text>
      <line x1="304" y1="238" x2="456" y2="238" class="svg-rule" />
      <text x="304" y="264" class="svg-mono">one port</text>
      <text x="304" y="284" class="svg-mono">one token</text>
    </g>

    <path d="M480 173H524" class="svg-line" marker-end="url(#flow-arrow)" />
    <path d="M480 247H524" class="svg-line" marker-end="url(#flow-arrow)" />

    <g class="svg-out">
      <rect x="536" y="118" width="200" height="110" rx="14" />
      <text x="556" y="150" class="svg-out-label">{labels.browser}</text>
      <text x="556" y="178" class="svg-out-title">noVNC</text>
      <text x="556" y="204" class="svg-mono">WSS · RFB</text>
    </g>
    <g class="svg-out">
      <rect x="536" y="250" width="200" height="110" rx="14" />
      <text x="556" y="282" class="svg-out-label">{labels.agent}</text>
      <text x="556" y="310" class="svg-out-title">MCP · VNC</text>
      <text x="556" y="336" class="svg-mono">WSS · RFB</text>
    </g>

    <text x="590" y="400" class="svg-caption">gateway: auth, then bytes</text>
  </svg>
</figure>
