---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
  align?: "start" | "center";
}

const { eyebrow, title, lead, align = "start" } = Astro.props;
---

<div class:list={["section-head", `align-${align}`]}>
  <p class="eyebrow">{eyebrow}</p>
  <h2>{title}</h2>
  {lead && <p class="section-lead">{lead}</p>}
</div>
