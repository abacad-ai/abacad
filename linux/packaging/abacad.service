# abacad relay connection, as a systemd *user* service.
#
# Keeps the device connected to the relay in the background using the saved
# config (~/.config/abacad/config), so control survives closing the GUI window —
# the window (abacad --gui) is just the front-end. Enable once with:
#
#   systemctl --user enable --now abacad.service
#
# This runs /usr/bin/abacad with no --gui, so it opens no window — but it is the
# same GTK-linked binary the launcher starts, not the cgo-free CLI build. One
# binary serves both roles; the .deb depends on libgtk-4-1/libadwaita-1-0 for that
# reason even though this unit never draws anything. If you want the genuinely
# cgo-free daemon (a server with no GTK installed), take the CLI tarball instead.
[Unit]
Description=abacad device agent (relay connection)
After=network-online.target
Wants=network-online.target

[Service]
ExecStart=/usr/bin/abacad
Restart=on-failure
RestartSec=5

[Install]
WantedBy=default.target
