<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows10.0.19041.0</TargetFramework>
    <TargetPlatformMinVersion>10.0.17763.0</TargetPlatformMinVersion>
    <RootNamespace>Abacad</RootNamespace>
    <AssemblyName>Abacad</AssemblyName>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>

    <!-- WinUI 3 (Windows App SDK), Fluent chrome. Unpackaged (WindowsPackageType
         None) so it ships as a plain .exe tray app like the old WinForms build,
         no MSIX required. The UI-Automation *client* work (reading other apps'
         trees) no longer rides on WPF — it uses FlaUI.UIA3 now, so UseWinUI and
         the UIA client coexist fine. -->
    <UseWinUI>true</UseWinUI>
    <WindowsPackageType>None</WindowsPackageType>
    <EnableMsixTooling>true</EnableMsixTooling>
    <Platforms>x64;arm64</Platforms>
    <RuntimeIdentifiers>win-x64;win-arm64</RuntimeIdentifiers>

    <!-- Custom entry point (Program.cs) so `abacad connect` can run the pairing
         CLI and exit before any WinUI init. WinUI 3 gates the Program/Main it
         generates into App.g.i.cs behind this *compiler constant* — the
         DisableXamlGeneratedMain MSBuild property is WPF-only and is silently
         ignored here, which collides with Program.cs (CS0101/CS0111). -->
    <DefineConstants>$(DefineConstants);DISABLE_XAML_GENERATED_MAIN</DefineConstants>

    <!-- PerMonitorV2 so GDI capture, UIA BoundingRectangle, and SendInput's
         absolute coordinates all agree in physical pixels. -->
    <ApplicationManifest>app.manifest</ApplicationManifest>

    <!-- Embeds Abacad.ico as the exe's Win32 icon resource. Without this the exe
         has no icon, so every shortcut the installer creates — Start Menu,
         desktop, taskbar pin — renders as the generic Windows executable glyph.
         Generated from assets/icon-rounded-1024.png by scripts/gen-win-ico.py and
         committed, the same arrangement as macos/AppIcon.icns. Unrelated to the
         tray glyph, which RelayMark.cs draws at runtime. -->
    <ApplicationIcon>Abacad.ico</ApplicationIcon>

    <!-- PublishSingleFile bundles managed assemblies but leaves NATIVE libraries
         loose beside the exe unless this is set. `make stage-windows` publishes
         exactly one file, so every loose .dll is a file the user never receives.
         Confirmed on the sibling CLI project, which publishes five of them
         (D3DCompiler_47_cor3, PresentationNative_cor3, wpfgfx_cor3, PenImc_cor3,
         vcruntime140_cor3) despite referencing strictly less than this project.
         NOT runtime-verified on Windows — see the README's known-limits note. -->
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>

    <!-- There are TWO runtimes to bundle, and the publish flag covers only one.
         SelfContained bundles the .NET runtime (it is why the exe is ~190 MB). The
         Windows App Runtime is a *separate* framework MSIX, and an unpackaged
         WinUI 3 app (WindowsPackageType None, above) defaults to resolving it
         from the machine — so v0.5.1 shipped an exe whose bootstrapper opened
         with "This application requires the Windows App Runtime Version 1.6
         (MSIX package version >= 6000.266.2241.0)" on a box that didn't have it.
         WindowsAppSDKSelfContained copies the WinAppSDK binaries into the publish
         output instead, which is what makes the download actually standalone.
         SelfContained is set here too so a plain `dotnet publish` agrees with the
         Makefile's command line rather than half-configuring itself. -->
    <SelfContained>true</SelfContained>
    <WindowsAppSDKSelfContained>true</WindowsAppSDKSelfContained>

    <!-- NOTE: Windows App SDK apps build on Windows. This drops the previous
         EnableWindowsTargeting cross-compile (the Mac-mini/Linux CI path) — the
         Windows client now needs a Windows build host. -->

    <Product>abacad</Product>
    <AssemblyTitle>abacad</AssemblyTitle>
    <!-- One monorepo version, read from the repo-root VERSION file at build time. -->
    <Version Condition="Exists('$(MSBuildThisFileDirectory)..\VERSION')">$([System.IO.File]::ReadAllText('$(MSBuildThisFileDirectory)..\VERSION').Trim())</Version>
    <Version Condition="!Exists('$(MSBuildThisFileDirectory)..\VERSION')">dev</Version>
  </PropertyGroup>

  <ItemGroup>
    <!-- The sibling CLI project lives under this project's directory, so the SDK's
         default **/*.cs glob would compile cli/Program.cs into the tray app and
         collide with our own Main (CS0101/CS0111) — and cli/obj too, since the
         default obj/bin exclusions are relative to *this* project. Sharing goes
         one way only: cli/Abacad.Cli.csproj Includes the sources it wants from
         here, and nothing here reaches into cli/. -->
    <Compile Remove="cli/**" />
    <None Remove="cli/**" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.WindowsAppSDK" Version="1.6.240923002" />
    <PackageReference Include="Microsoft.Windows.SDK.BuildTools" Version="10.0.26100.1742" />
    <!-- Tray icon at the Win32 (Shell_NotifyIcon) level — WinUI has no NotifyIcon.
         The base package is the XAML-free one (its types live in the
         H.NotifyIcon.Core *namespace*; there is no H.NotifyIcon.Core package) and
         takes an HICON directly, so RelayMark's GDI-drawn icon is reused as-is.
         The .Wpf/.WinUI/.Maui siblings are the XAML flavours — we want none. -->
    <PackageReference Include="H.NotifyIcon" Version="2.1.3" />
    <!-- UI-Automation client (reads/drives other apps' trees), replacing the old
         System.Windows.Automation (which came in via UseWPF). -->
    <PackageReference Include="FlaUI.UIA3" Version="4.0.0" />
    <!-- GDI+ for RelayMark's tray glyph + ScreenCapture, now that UseWindowsForms
         (which used to provide System.Drawing) is gone. -->
    <PackageReference Include="System.Drawing.Common" Version="8.0.8" />
    <!-- DPAPI (ProtectedData) encrypts the stored server URL (device token) at rest. -->
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="8.0.0" />
  </ItemGroup>

</Project>
