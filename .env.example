# Copy to .env and fill in. .env is gitignored; this file is not — keep real
# secrets out of it.
#
# Loaded by the Go server at startup (see server/backend/internal/config).
# Anything already set in the real environment wins.
#
# This is local dev config only. Production has its own .env, shipped by the
# deploy script in the infra repo (deployment/xyz-sg-1/abacad.ai/) — changing
# values here does not affect abacad.ai.

# --- Sign in with Google -----------------------------------------------------
# From https://console.cloud.google.com/apis/credentials — an "OAuth 2.0 Client
# ID" of type "Web application". Both must be set or the button stays hidden.
ABACAD_GOOGLE_CLIENT_ID=
ABACAD_GOOGLE_CLIENT_SECRET=
# Optional. Derived from the incoming request when empty. Set it in production
# so the callback never depends on proxy X-Forwarded-* headers. Must match a
# redirect URI registered on the OAuth client, exactly.
# ABACAD_GOOGLE_REDIRECT_URL=https://abacad.ai/api/auth/google/callback

# --- Server ------------------------------------------------------------------
# ABACAD_ADDR=:8848
# ABACAD_DB=abacad.db
# ABACAD_BLOBS=blobs
# ABACAD_SCREENSHOTS=screenshots
# ABACAD_REPLAY=replay
# ABACAD_DOWNLOADS=downloads
# ABACAD_MAX_BLOB_BYTES=1073741824
# ABACAD_ACTIVITY_RETENTION_DAYS=90
# Data-minimization retention (0 = keep forever):
# ABACAD_BLOB_RETENTION_DAYS=7          # transferred files + screen recordings
# ABACAD_SCREENSHOT_RETENTION_HOURS=24  # cached per-device screenshots
# Session replay is OFF per device until its owner enables it in the dashboard. These
# two knobs bound what is kept once it is on — the window alone does not bound disk,
# since one busy agent can record thousands of frames well inside it:
# ABACAD_REPLAY_RETENTION_HOURS=48         # delete recorded steps + frames older than this
# ABACAD_REPLAY_MAX_STEPS_PER_DEVICE=4000  # keep at most this many steps per device (0 = unlimited)
# After a tap/click/swipe the recorder takes its own screenshot, so the replay shows what the
# action DID and not only the screen it acted on. This is the one place an observability feature
# sends a command to a device — turn it off here without turning recording off:
# ABACAD_REPLAY_CAPTURE_ACTIONS=1
# ABACAD_REPLAY_SETTLE_MS=800              # let the UI settle first; skipped if a frame arrives meanwhile
# Devices auto-expire 24h after enrollment (fixed product behavior, not configurable);
# extend or "make permanent" per device to keep. This knob is only the retention window
# for the dormant rows left behind:
# ABACAD_DEVICE_DORMANT_DELETE_DAYS=7   # hard-delete a device this long after it expires (0 = keep)
# ABACAD_DEV_CORS=1

# --- SSH jump host (empty disables it) ---------------------------------------
# ABACAD_SSH_ADDR=:22,:443
# ABACAD_SSH_HOST_KEY=ssh_host_ed25519_key
# ABACAD_BASE_DOMAIN=abacad.ai

# --- Signed /blobs capability URLs (send_file / get_file) --------------------
# HMAC key for the short-lived signed URLs the file-transfer tools hand back. If
# empty, the server generates a random key at boot (fine for a single instance);
# set it to persist URLs across restarts or share a key across instances. Keep
# the real value out of this file — put it in the real .env / host compose.
# ABACAD_BLOB_SIGNING_KEY=
# Scheme+host the minted URLs point at. Empty derives https://<base-domain>.
# Override for local testing so the URLs are actually reachable.
# ABACAD_PUBLIC_BASE_URL=http://127.0.0.1:8848
